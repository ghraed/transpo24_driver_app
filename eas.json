{
  "cli": {
    "version": ">= 20.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "local",
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:3001",
        "EXPO_PUBLIC_SOCKET_URL": "http://127.0.0.1:3001",
        "EXPO_PUBLIC_ANDROID_API_URL": "http://127.0.0.1:3001",
        "EXPO_PUBLIC_ANDROID_SOCKET_URL": "http://127.0.0.1:3001"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.transpo24.com",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.transpo24.com",
        "EXPO_PUBLIC_ANDROID_API_URL": "https://api.transpo24.com",
        "EXPO_PUBLIC_ANDROID_SOCKET_URL": "https://api.transpo24.com"
      },
      "channel": "preview"
    },
    "play-test": {
      "distribution": "store",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.transpo24.com",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.transpo24.com",
        "EXPO_PUBLIC_ANDROID_API_URL": "https://api.transpo24.com",
        "EXPO_PUBLIC_ANDROID_SOCKET_URL": "https://api.transpo24.com"
      },
      "autoIncrement": true,
      "channel": "play-test"
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.transpo24.com",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.transpo24.com",
        "EXPO_PUBLIC_ANDROID_API_URL": "https://api.transpo24.com",
        "EXPO_PUBLIC_ANDROID_SOCKET_URL": "https://api.transpo24.com"
      },
      "autoIncrement": true,
      "channel": "production"
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "production-apk"
    }
  },
  "submit": {
    "play-test": {
      "android": {
        "track": "internal"
      }
    },
    "production": {
      "android": {
        "track": "production"
      }
    }
  }
}
